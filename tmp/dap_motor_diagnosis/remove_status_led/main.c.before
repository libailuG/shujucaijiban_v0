#include "stm32h7xx.h"
#include "imu.h"
#include "imu_bus.h"
#include "battery.h"
#include "reserved_uart2.h"
#include "motor_bus.h"

/* Schematic page 2: LED6 green=PG9, LED5 red=PG11, LED4 blue=PG14.
 * Anodes connect to 3.3 V through resistors: LOW=ON, HIGH=OFF. */
#define GREEN_LED (1UL << 9)
#define RED_LED   (1UL << 11)
#define BLUE_LED  (1UL << 14)
/* bit0=SW1/PC12, bit1=SW2/PC11, bit2=SW3/PB4; 1 means pressed.
 * State is published only after 20 consecutive equal 1ms samples. */
volatile uint32_t g_button_state;
static uint8_t button_debounce_ms[3];
static uint8_t green_on = 1U;
extern uint32_t BoardClock_Config550MHz(void);

/* 蓝灯 PG14（低电平亮）的四路状态显示说明：
 * 每轮：快速闪3下 -> 灭1秒 -> 左电机 -> 右电机 -> 板载IMU -> ESP32-C6
 *       -> 灭2秒 -> 下一轮。看到三连闪后，第一组就是左电机。
 * 起始标记：每次亮100ms，两次之间灭100ms；第三次亮后灭1000ms。
 * 状态组：正常亮500ms，异常/未收到有效数据亮100ms，组间灭300ms；
 *         C6组结束直接灭2000ms。每组开始时取状态，组内亮时长不变。
 * 正常判据：有效反馈/采样持续更新；左/右电机超时200ms，IMU超时100ms，
 *           C6超时500ms（预设，若C6实际发送更慢需同步调整）。
 * 错误字节、零散字节不刷新状态；只看有效帧/成功采样计数及时间戳。
 * 使用非阻塞状态机，不延时、不影响通信；绿灯电量和红灯用途不变。
 * Watch: g_link_led_status bit0左/bit1右/bit2IMU/bit3C6，1表示近期有效；
 *        g_link_led_phase=0..5起始标记，6/8/10/12分别为四组亮灯阶段，
 *        7/9/11为组间隔，13为轮末间隔；g_link_led_on=1表示蓝灯亮。
 */
#define LINK_MOTOR_TIMEOUT_US 200000U
#define LINK_IMU_TIMEOUT_US   100000U
#define LINK_C6_TIMEOUT_US    500000U
volatile uint32_t g_link_led_status, g_link_led_phase, g_link_led_on;
static void link_status_led_poll(void)
{
    static uint32_t seen[4], stamp[4], fresh, phase_since, phase_duration;
    static uint8_t started;
    uint32_t now = imu_time_us();
    uint32_t counts[4] = {g_motor_left.rx_frame_count, g_motor_right.rx_frame_count,
        g_imu_data.sample_count, g_uart2_rx_frame_count};
    uint32_t timestamps[4] = {g_motor_left.rx_timestamp_us, g_motor_right.rx_timestamp_us,
        g_imu_data.timestamp_us, g_uart2_rx_timestamp_us};
    uint32_t valid[4] = {g_motor_left.rx_valid, g_motor_right.rx_valid,
        g_imu_data.valid, g_uart2_rx_valid};
    static const uint32_t timeout[4] = {LINK_MOTOR_TIMEOUT_US, LINK_MOTOR_TIMEOUT_US,
        LINK_IMU_TIMEOUT_US, LINK_C6_TIMEOUT_US};
    for (unsigned i = 0; i < 4U; ++i) {
        uint32_t bit = 1UL << i;
        if (counts[i] != seen[i]) {
            seen[i] = counts[i]; stamp[i] = timestamps[i]; fresh |= bit;
        }
        /* 超时后锁定为异常，直到新数据到达，避免TIM2回绕后旧数据假恢复。 */
        if (!valid[i] || (uint32_t)(now - stamp[i]) >= timeout[i]) fresh &= ~bit;
    }
    g_link_led_status = fresh;
    if (started && (uint32_t)(now - phase_since) < phase_duration) return;
    uint32_t phase = started ? (g_link_led_phase + 1U) % 14U : 0U;
    started = 1U; g_link_led_phase = phase; phase_since = now;
    uint32_t on = 0U;
    if (phase < 5U) {
        on = (phase & 1U) == 0U; phase_duration = 100000U;
    } else if (phase == 5U) {
        phase_duration = 1000000U;
    } else if (phase == 13U) {
        phase_duration = 2000000U;
    } else if ((phase & 1U) == 0U) {
        unsigned channel = (phase - 6U) / 2U;
        on = 1U; phase_duration = (fresh & (1UL << channel)) ? 500000U : 100000U;
    } else {
        phase_duration = 300000U;
    }
    g_link_led_on = on;
    GPIOG->BSRR = on ? (BLUE_LED << 16) : BLUE_LED;
}

static void buttons_init(void)
{
    RCC->AHB4ENR |= RCC_AHB4ENR_GPIOBEN | RCC_AHB4ENR_GPIOCEN;
    (void)RCC->AHB4ENR;
    /* Active-low switches; external pull-ups exist on the schematic.
     * Also enable internal pull-ups. PB4 is NJTRST after reset; selecting
     * GPIO input releases that function, while PA13/PA14 SWD stays intact. */
    GPIOC->MODER &= ~((3UL << 22) | (3UL << 24));
    GPIOC->PUPDR = (GPIOC->PUPDR & ~((3UL << 22) | (3UL << 24))) |
        (1UL << 22) | (1UL << 24);
    GPIOB->MODER &= ~(3UL << 8);
    GPIOB->PUPDR = (GPIOB->PUPDR & ~(3UL << 8)) | (1UL << 8);
}

static void buttons_scan_1ms(void)
{
    uint32_t pc = GPIOC->IDR;
    uint32_t pb = GPIOB->IDR;
    uint32_t raw = (((pc >> 12) & 1U) ^ 1U) |
        ((((pc >> 11) & 1U) ^ 1U) << 1) |
        ((((pb >> 4) & 1U) ^ 1U) << 2);
    for (uint32_t i = 0U; i < 3U; ++i) {
        uint32_t mask = 1UL << i;
        if (((raw ^ g_button_state) & mask) == 0U) {
            button_debounce_ms[i] = 0U;
        } else if (++button_debounce_ms[i] >= 20U) {
            button_debounce_ms[i] = 0U;
            g_button_state ^= mask;
        }
    }
}

void SysTick_Handler(void)
{
    buttons_scan_1ms();
}

static void led_timer_init(void)
{
    /* Fixed board clocks: HCLK=275MHz, APB1=137.5MHz, TIMPRE=0.
     * APB1 divider /2 doubles the timer kernel clock to 275MHz.
     * 275MHz / (27499+1) = 10kHz; ARR controls battery indication. */
    RCC->CFGR &= ~RCC_CFGR_TIMPRE;
    RCC->APB1LENR |= RCC_APB1LENR_TIM6EN;
    (void)RCC->APB1LENR;
    TIM6->CR1 = TIM_CR1_ARPE;
    TIM6->CR2 = 0U;
    TIM6->DIER = 0U;
    TIM6->PSC = 27499U;
    TIM6->ARR = 4999U;
    TIM6->CNT = 0U;
    TIM6->EGR = TIM_EGR_UG; /* Load PSC/ARR before starting the counter. */
    TIM6->SR = 0U; /* Discard the update event generated by UG. */
    NVIC_ClearPendingIRQ(TIM6_DAC_IRQn);
    NVIC_SetPriority(TIM6_DAC_IRQn, 3U);
    NVIC_EnableIRQ(TIM6_DAC_IRQn);
    TIM6->DIER = TIM_DIER_UIE;
    TIM6->CR1 |= TIM_CR1_CEN;
}

void TIM6_DAC_IRQHandler(void)
{
    if ((TIM6->SR & TIM_SR_UIF) != 0U) {
        TIM6->SR = 0U;
        green_on ^= 1U;
        GPIOG->BSRR = green_on ? (GREEN_LED << 16) : GREEN_LED;
    }
    __DSB(); /* Complete peripheral writes before exception return on M7. */
}

int main(void)
{
    const uint32_t leds = GREEN_LED | RED_LED | BLUE_LED;
    RCC->AHB4ENR |= RCC_AHB4ENR_GPIOGEN;
    (void)RCC->AHB4ENR;

    GPIOG->BSRR = leds; /* Set output latches OFF before enabling outputs. */
    GPIOG->OTYPER &= ~leds;
    GPIOG->PUPDR &= ~((3UL << 18) | (3UL << 22) | (3UL << 28));
    GPIOG->OSPEEDR &= ~((3UL << 18) | (3UL << 22) | (3UL << 28));
    GPIOG->MODER = (GPIOG->MODER &
        ~((3UL << 18) | (3UL << 22) | (3UL << 28))) |
        (1UL << 18) | (1UL << 22) | (1UL << 28);
    buttons_init();
    GPIOG->BSRR = GREEN_LED << 16; /* Start heartbeat immediately at boot. */

    if (BoardClock_Config550MHz() != 0U) {
        GPIOG->BSRR = RED_LED << 16;
        for (;;) { __NOP(); } /* Clock startup failed: keep red LED on. */
    }
    if (SysTick_Config(SystemCoreClock / 1000UL) != 0U) {
        for (;;) { /* Invalid tick configuration. */ }
    }
    led_timer_init();
    imu_init();
    battery_init();
    reserved_uart2_init();
    motor_bus_init();

    for (;;) {
        imu_poll();
        battery_poll();
        reserved_uart2_poll();
        motor_bus_poll();
        link_status_led_poll();
        /* ARPE applies the new half-period at the next timer update. */
        TIM6->ARR = g_battery_data.led_half_period_ms * 10U - 1U;
    }
}
